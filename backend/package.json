{
  "name": "blog-management-system-backend",
  "version": "1.0.0",
  "description": "Production-ready backend for MERN Blog Management System",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node api.js && node src/server.js",
    "dev": "node api.js && nodemon src/server.js",
    "seed": "node src/utils/seed.js",
