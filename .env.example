# Root Environment Variables for Docker Compose Setup
NODE_ENV=development

# Backend
BACKEND_PORT=5000
MONGODB_URI=mongodb://mongo:27017/blog_management_db
CLIENT_URL=http://localhost:5173

# JWT
JWT_ACCESS_SECRET=docker_jwt_access_secret_super_secure_key_1234567890
JWT_REFRESH_SECRET=docker_jwt_refresh_secret_super_secure_key_0987654321
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:5000/api/v1/auth/facebook/callback

# Frontend
FRONTEND_PORT=5173
VITE_API_URL=http://localhost:5000/api/v1
VITE_SOCKET_URL=http://localhost:5000
